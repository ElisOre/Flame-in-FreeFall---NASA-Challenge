# --- Configuración de Base de Datos Relacional (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password_de_mysql
MYSQL_DATABASE=tu_base_de_datos

# --- Configuración de Base de Datos Vectorial (Qdrant) ---
# Si usas Qdrant local en carpeta, deja QDRANT_URL vacío.
# Si despliegas en la nube con Qdrant Cloud (gratis), pon aquí su URL y API Key.
QDRANT_PATH=./qdrant_tu_db
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=nombre_collection

# --- API Key del Modelo de IA (Para tu agente en el Dashboard) ---
LLM_API_KEY=tu_api_key_de_gemini_openai_etc

# --- Puerto del Backend para alimentar la Página Web ---
API_PORT=8000